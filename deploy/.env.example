# Mira local Docker deployment — env template. Copy to .env and edit:
#     cp .env.example .env
# Then put SECRETS + provider overrides in .env.local (git-ignored, loaded
# last so it WINS). Regenerating .env from this template never touches .env.local
# — that is what keeps your model/key from silently reverting.

# --- deployment shape -------------------------------------------------------
DEPLOYMENT_PROFILE=local
PLATFORM=local
LOG_LEVEL=INFO

# --- tools (Vantage MCP over the host published port) -----------------------
# Vantage's compose publishes vantage-mcp on host :8640. Mira (a separate
# stack) reaches it via host.docker.internal — no shared docker network.
MCP_BASE_URL=http://host.docker.internal:8640/mcp

# --- model ------------------------------------------------------------------
# DeepSeek hosted API by default. Override to a host Ollama in .env.local:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen2.5:7b
#   LLM_API_KEY=ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Tier routing (ADR-052): light = the fast model (playbook narrator, facets),
# deep = the strong model (analysis synthesis / trade desk reviews).
MODEL_ROUTES=[{"provider":"deepseek","model":"deepseek-chat","tier":"light","cost_per_1k_tokens":0.00028},{"provider":"deepseek","model":"deepseek-reasoner","tier":"deep","cost_per_1k_tokens":0.0022}]
ENABLE_TIER_ESCALATION=
