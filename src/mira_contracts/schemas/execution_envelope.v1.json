{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mira-contracts/execution_envelope.v1.json",
  "title": "ExecutionEnvelope v1 (ADR-049)",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_version", "task_id", "objective"],
  "properties": {
    "envelope_version": {"const": "1"},
    "task_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string"},
    "tenant": {"type": "string"},
    "objective": {"type": "string", "minLength": 1},
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_hitl": {"type": "boolean"},
        "allow_destructive": {"type": "boolean"},
        "max_iterations": {"type": "integer", "minimum": 0},
        "disallowed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tool_grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name_prefix", "entitlement"],
        "properties": {
          "name_prefix": {"type": "string", "minLength": 1},
          "entitlement": {"type": "string", "minLength": 1}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_seconds": {"type": "number", "minimum": 0},
        "max_cost": {"type": "number", "minimum": 0}
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["answer_field", "grounded", "min_trace_score"]},
          "key": {"type": "string"},
          "expected": {},
          "threshold": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
